{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/scripts/session_context.py\"",
            "timeout": 15,
            "statusMessage": "Checking repository and evidence state"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/scripts/claude_guard.py\"",
            "timeout": 15,
            "statusMessage": "Checking whether this file is sensitive"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/scripts/claude_guard.py\"",
            "timeout": 15,
            "statusMessage": "Checking whether this command is sensitive"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/scripts/completion_gate.py\"",
            "timeout": 20,
            "statusMessage": "Checking evidence before allowing completion"
          }
        ]
      }
    ]
  }
}
