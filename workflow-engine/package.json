{
  "name": "appbi-workflow-engine",
  "version": "1.0.0",
  "private": true,
  "description": "Internal n8n runtime service. The only place in this repo allowed to import n8n packages.",
  "engines": {
    "node": ">=20 <23"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:contract": "vitest run tests/contract",
    "spike": "tsx tests/spike/bootstrap-probe.ts"
  },
  "dependencies": {
    "express": "4.22.2",
    "n8n-core": "1.14.1",
    "n8n-nodes-base": "1.14.1",
    "n8n-workflow": "1.14.1",
    "typedi": "0.10.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "20.17.10",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  },
  "overrides": {
    "qs": "6.16.0",
    "axios": "1.18.0"
  }
}
