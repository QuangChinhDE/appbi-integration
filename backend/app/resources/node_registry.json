                  },
                  {
                    "value": "ends_with",
                    "label": "kết thúc bằng"
                  },
                  {
                    "value": "gt",
                    "label": "lớn hơn"
                  },
                  {
                    "value": "gte",
                    "label": "lớn hơn hoặc bằng"
                  },
                  {
                    "value": "lt",
                    "label": "nhỏ hơn"
                  },
                  {
                    "value": "lte",
                    "label": "nhỏ hơn hoặc bằng"
                  },
                  {
                    "value": "is_empty",
                    "label": "rỗng"
                  },
                  {
                    "value": "is_not_empty",
                    "label": "không rỗng"
                  },
                  {
                    "value": "is_true",
                    "label": "đúng"
                  },
                  {
                    "value": "is_false",
                    "label": "sai"
