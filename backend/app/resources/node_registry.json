              },
              {
                "key": "value",
                "label": "Giá trị",
                "type": "string",
                "expression_supported": true
              }
            ],
            "description": "Không đặt header xác thực ở đây; dùng mục Thông tin xác thực."
          },
          {
            "key": "body_mode",
            "label": "Body",
            "type": "enum",
            "default": "NONE",
            "options": [
              {
                "value": "NONE",
                "label": "Không gửi body"
              },
              {
                "value": "JSON",
                "label": "JSON"
              },
              {
                "value": "FORM",
                "label": "Form URL-encoded"
              }
            ]
          },
          {
            "key": "json_body",
            "label": "JSON body",
            "type": "json",
            "expression_supported": true,
            "condition": {
              "field": "body_mode",
              "equals": "JSON"
            }
          },
          {
            "key": "form_body",
            "label": "Form fields",
            "type": "collection",
            "condition": {
              "field": "body_mode",
              "equals": "FORM"
            },
            "item_fields": [
              {
                "key": "name",
                "label": "Tên",
                "type": "string",
                "required": true
              },
              {
                "key": "value",
                "label": "Giá trị",
                "type": "string",
                "expression_supported": true
              }
            ]
          },
          {
            "key": "response_format",
            "label": "Định dạng phản hồi",
            "type": "enum",
            "advanced": true,
            "default": "AUTO",
            "options": [
              {
                "value": "AUTO",
                "label": "Tự nhận"
              },
              {
                "value": "JSON",
                "label": "JSON"
              },
              {
                "value": "TEXT",
                "label": "Text"
              }
            ]
          },
          {
            "key": "timeout_ms",
            "label": "Timeout (ms)",
            "type": "number",
            "advanced": true,
            "default": 30000,
            "min": 1000,
            "max": 300000
          },
          {
            "key": "continue_on_error",
            "label": "Tiếp tục khi lỗi",
            "type": "boolean",
            "advanced": true,
            "default": false,
            "description": "Nếu bật, lỗi HTTP đi vào dữ liệu đầu ra thay vì dừng workflow."
          }
