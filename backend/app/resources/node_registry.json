              },
              {
                "key": "value_type",
                "label": "Kiểu dữ liệu",
                "type": "enum",
                "default": "string",
                "options": [
                  {
                    "value": "string",
                    "label": "Text"
                  },
                  {
                    "value": "number",
                    "label": "Number"
                  },
                  {
                    "value": "boolean",
                    "label": "Boolean"
                  }
                ]
              },
              {
                "key": "right",
                "label": "So với",
                "type": "string",
                "expression_supported": true
              }
            ]
          }
        ]
      },
