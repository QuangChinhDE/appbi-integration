{
  "$comment": [
    "Product-owned node catalogue (SRS 11). Seeded into `node_definitions` at",
    "boot so the palette and Node Library render from the product database even",
    "when the engine is down.",
    "",
    "`config_schema.fields` is the form the FE renders (SRS 54) -- it is NOT an",
    "n8n node description. `engine_binding` is backend-only and must never",
    "appear in a non-admin response (guardrail 9).",
    "",
    "Adding a node here is not enough to ship it: the engine's compiler has to",
    "know the mapping, the golden tests have to cover it, and certification has",
    "to move to SUPPORTED."
  ],
  "product_schema_version": 1,
  "nodes": [
    {
      "node_key": "manual_trigger",
      "display_name": "Manual Trigger",
      "category": "TRIGGER",
      "description": "Bắt đầu workflow khi bạn bấm Run. Dùng để thử nghiệm.",
      "icon": "mouse-pointer-click",
      "certification": "SUPPORTED",
      "status": "ACTIVE",
      "config_schema": {
        "fields": [
          {
            "key": "test_payload",
            "label": "Dữ liệu thử",
            "type": "json",
            "required": false,
            "advanced": true,
            "default": {},
            "description": "JSON được dùng làm dữ liệu đầu vào khi chạy thử."
          }
        ]
      },
      "capability": {
        "input_ports": [],
        "output_ports": [
          {
            "key": "main",
            "label": "Out"
          }
        ],
        "supports_expression": false,
        "credential_types": [],
        "is_trigger": true
      },
      "engine_binding": {
        "engine": "N8N",
        "engine_node_type": "appbi.start",
        "engine_type_version": 1,
        "adapter_version": "1"
      },
      "security_profile": {
        "network": "NONE",
        "code_execution": false,
        "file_access": false,
        "external_side_effects": false
      },
      "docs_ref": "/docs/nodes/manual-trigger"
    },
    {
      "node_key": "webhook_trigger",
      "display_name": "Webhook Trigger",
      "category": "TRIGGER",
      "description": "Bắt đầu workflow khi có request gọi tới URL webhook của workflow.",
      "icon": "webhook",
      "certification": "SUPPORTED",
      "status": "ACTIVE",
      "config_schema": {
        "fields": [
          {
            "key": "method",
            "label": "HTTP method",
            "type": "enum",
            "required": true,
            "default": "POST",
            "options": [
              {
                "value": "POST",
                "label": "POST"
              },
              {
                "value": "GET",
                "label": "GET"
              },
              {
                "value": "PUT",
                "label": "PUT"
              },
              {
                "value": "PATCH",
                "label": "PATCH"
              },
              {
                "value": "DELETE",
                "label": "DELETE"
              }
            ]
          },
          {
            "key": "auth_mode",
            "label": "Xác thực",
            "type": "enum",
            "required": true,
            "default": "HEADER_SIGNATURE",
            "options": [
              {
                "value": "NONE",
                "label": "Không (công khai)"
              },
              {
                "value": "BASIC",
                "label": "HTTP Basic"
              },
              {
                "value": "HEADER_SIGNATURE",
                "label": "Ký HMAC theo header"
              }
            ],
            "description": "URL webhook luôn chứa khóa ngẫu nhiên; xác thực là lớp bảo vệ thứ hai."
          },
          {
            "key": "allowed_content_type",
            "label": "Content-Type cho phép",
            "type": "enum",
            "advanced": true,
            "default": "application/json",
            "options": [
              {
                "value": "application/json",
                "label": "application/json"
              },
              {
                "value": "*",
                "label": "Bất kỳ"
              }
            ]
          },
          {
            "key": "max_body_bytes",
            "label": "Kích thước body tối đa (bytes)",
            "type": "number",
            "advanced": true,
            "default": 262144,
            "min": 1024,
            "max": 524288
          }
        ]
      },
      "capability": {
        "input_ports": [],
        "output_ports": [
          {
            "key": "main",
            "label": "Out"
          }
        ],
        "supports_expression": false,
        "credential_types": [],
        "is_trigger": true,
        "trigger_type": "WEBHOOK"
      },
      "engine_binding": {
        "engine": "N8N",
        "engine_node_type": "appbi.start",
        "engine_type_version": 1,
        "adapter_version": "1",
        "$comment": "Deliberately NOT n8n-nodes-base.webhook: the public endpoint is the product's (ADR-005). The engine only receives the payload the gateway accepted."
      },
      "security_profile": {
        "network": "INBOUND_PUBLIC",
        "code_execution": false,
        "file_access": false,
        "external_side_effects": false
      },
      "docs_ref": "/docs/nodes/webhook-trigger"
    },
    {
      "node_key": "schedule_trigger",
      "display_name": "Schedule Trigger",
      "category": "TRIGGER",
      "description": "Chạy workflow theo lịch: theo chu kỳ, hằng ngày hoặc theo biểu thức cron.",
      "icon": "clock",
      "certification": "SUPPORTED",
      "status": "ACTIVE",
      "config_schema": {
        "fields": [
          {
            "key": "schedule_type",
            "label": "Kiểu lịch",
            "type": "enum",
            "required": true,
            "default": "INTERVAL",
            "options": [
              {
                "value": "INTERVAL",
                "label": "Theo chu kỳ"
              },
              {
                "value": "DAILY",
                "label": "Hằng ngày"
              },
              {
                "value": "CRON",
                "label": "Cron"
              }
            ]
          },
          {
            "key": "interval_seconds",
            "label": "Chu kỳ (giây)",
            "type": "number",
            "default": 3600,
            "min": 60,
            "max": 2592000,
            "condition": {
              "field": "schedule_type",
              "equals": "INTERVAL"
            }
          },
          {
            "key": "time_of_day",
            "label": "Giờ chạy",
            "type": "time",
            "default": "02:00",
            "condition": {
              "field": "schedule_type",
              "equals": "DAILY"
            }
          },
          {
            "key": "cron_expression",
            "label": "Biểu thức cron",
            "type": "string",
            "placeholder": "0 2 * * *",
            "condition": {
              "field": "schedule_type",
              "equals": "CRON"
            }
          },
          {
            "key": "timezone",
            "label": "Múi giờ",
            "type": "timezone",
            "default": "Asia/Bangkok",
            "description": "Lịch được tính theo múi giờ này, không theo múi giờ của trình duyệt."
          },
          {
            "key": "overlap_policy",
            "label": "Khi lần chạy trước chưa xong",
            "type": "enum",
            "advanced": true,
            "default": "SKIP_IF_RUNNING",
            "options": [
              {
                "value": "SKIP_IF_RUNNING",
                "label": "Bỏ qua lần này"
              },
              {
                "value": "ALLOW",
                "label": "Vẫn chạy song song"
              }
            ]
          }
        ]
      },
      "capability": {
        "input_ports": [],
        "output_ports": [
          {
            "key": "main",
            "label": "Out"
          }
        ],
        "supports_expression": false,
        "credential_types": [],
        "is_trigger": true,
        "trigger_type": "SCHEDULE"
      },
      "engine_binding": {
        "engine": "N8N",
        "engine_node_type": "appbi.start",
        "engine_type_version": 1,
        "adapter_version": "1",
        "$comment": "The product scheduler fires this (ADR-004); n8n's cron node is never registered."
      },
      "security_profile": {
        "network": "NONE",
        "code_execution": false,
        "file_access": false,
        "external_side_effects": false
      },
      "docs_ref": "/docs/nodes/schedule-trigger"
    },
    {
      "node_key": "http_request",
      "display_name": "HTTP Request",
