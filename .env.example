# Copy to `.env` and fill in. Nothing here has a production-safe default:
# `app/core/readiness.py` refuses to start a production deployment that still
# carries the development placeholders.

# ── environment ────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
PRODUCT_VERSION=1.0.0

# ── database ───────────────────────────────────────────────────────────────
# Port 5433 matches docker-compose, which avoids clashing with a Postgres you
# already run locally.
DATABASE_URL=postgresql+asyncpg://appbi:appbi@localhost:5433/appbi_workflow

# ── auth ───────────────────────────────────────────────────────────────────
# At least 32 characters. Changing it invalidates every open session.
JWT_SECRET=dev-only-change-me-please-32-chars-min
SESSION_TTL_SECONDS=43200
SESSION_COOKIE_SECURE=false          # must be true in production

# ── secrets ────────────────────────────────────────────────────────────────
# A 32-byte urlsafe-base64 key. Generate one with:
#   python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Losing it means losing every stored credential; rotate with
# `app.core.secrets.rewrap_all`, which rewraps data keys without touching
# ciphertext.
SECRET_ENCRYPTION_KEY=
# Development only: lets a passphrase stand in for a real key. Refused in
# production, because then every credential is protected by that passphrase's
# entropy.
ALLOW_DERIVED_ENCRYPTION_KEY=true

# ── engine boundary ────────────────────────────────────────────────────────
ENGINE_TYPE=N8N_CORE
# Internal address. Never sent to a browser, never in an API response.
ENGINE_BASE_URL=http://localhost:8099
ENGINE_INTERNAL_TOKEN=dev-engine-token
ENGINE_TIMEOUT_SECONDS=30
ENGINE_DISPATCH_TIMEOUT_SECONDS=15
# Refuse to boot when the engine is unreachable. Off by default: the product is
# designed to stay readable during an engine outage (SRS 9.6).
STARTUP_REQUIRE_ENGINE=false

# ── execution policy ───────────────────────────────────────────────────────
EXECUTION_MAX_RUNTIME_SECONDS=1200
EXECUTION_STALE_AFTER_SECONDS=120
MAX_CONCURRENT_EXECUTIONS_PER_WORKFLOW=1
MAX_CONCURRENT_EXECUTIONS_PER_WORKSPACE=10
# How long node input/output previews are kept. Execution summaries live far
# longer; the payloads that passed through them do not (SRS 57).
EXECUTION_PREVIEW_RETENTION_DAYS=14

# ── webhook gateway ────────────────────────────────────────────────────────
# The origin webhook URLs are built from. Must be https in production: this
# value is handed to third parties.
PUBLIC_BASE_URL=http://localhost:8000
WEBHOOK_MAX_BODY_BYTES=524288
WEBHOOK_RATE_LIMIT_PER_MINUTE=120

# ── HTTP Request egress policy (SRS 32.2) ──────────────────────────────────
# Allows workflows to reach loopback and RFC1918 addresses. Keep false unless
# the deployment genuinely needs it; cloud metadata stays blocked either way.
EGRESS_ALLOW_PRIVATE_NETWORKS=false
# Comma-separated. An allowlist is exclusive: set it and nothing else is
# reachable.
EGRESS_ALLOWED_HOSTS=
EGRESS_BLOCKED_HOSTS=169.254.169.254,metadata.google.internal
EGRESS_MAX_REDIRECTS=5
EGRESS_MAX_RESPONSE_BYTES=8388608
EGRESS_REQUEST_TIMEOUT_SECONDS=60

# ── engine service ─────────────────────────────────────────────────────────
ENGINE_PORT=8099
ENGINE_HOST=127.0.0.1
ENGINE_LOG_LEVEL=info
ENGINE_MAX_CONCURRENT=20
ENGINE_MAX_EXECUTION_SECONDS=1800

# ── bootstrap (first run only) ─────────────────────────────────────────────
# The created account must change this password before it can do anything else,
# so what is in your deployment pipeline is a one-time secret, not a credential.
BOOTSTRAP_ADMIN_EMAIL=admin@appbi.vn
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_TIMEZONE=Asia/Bangkok

# ── frontend ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE=http://localhost:8000
