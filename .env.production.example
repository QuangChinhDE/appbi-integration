# Production configuration template.
#
# Copy to `.env.production`, fill every value, then verify with:
#
#     python scripts/doctor.py --env-file .env.production
#
# The doctor refuses a file that still contains a placeholder, a development
# secret, a plaintext http:// URL, a localhost database or an unpinned image
# tag -- and the API refuses to start on one, so a bad value fails at deploy
# time rather than in production.
#
# Every FILL_ME below must be replaced. Nothing here is a working default on
# purpose: a production template with defaults that boot is a production
# template people ship unedited.

# ── environment ────────────────────────────────────────────────────────────
# This value is what turns the strict checks on. Do not set it to anything
# else in production.
APP_ENV=production
LOG_LEVEL=INFO
LOG_FORMAT=json
# The exact release. Appears in every log line and in the release artefact, and
# is what a support conversation starts from.
PRODUCT_VERSION=FILL_ME

# ── database ───────────────────────────────────────────────────────────────
# A managed instance, not a container in this compose file. The doctor rejects
# localhost/127.0.0.1 and a `postgres` service hostname here: a database whose
# lifecycle is tied to the application's is a database that gets deleted with
# `docker compose down -v`.
#
# `sslmode` is not an asyncpg parameter -- use `ssl=require` (or `ssl=verify-full`
# with a CA file configured on the host).
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@db.internal.example.com:5432/appbi_workflow?ssl=require

# ── auth ───────────────────────────────────────────────────────────────────
# At least 48 characters of real entropy. Changing it signs everybody out.
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=FILL_ME
SESSION_TTL_SECONDS=43200
# Must be true: the session cookie is the whole session.
SESSION_COOKIE_SECURE=true
LOGIN_MAX_ATTEMPTS=8
LOGIN_LOCKOUT_SECONDS=300
# Per source address, counted in the database so it is shared across replicas.
LOGIN_RATE_LIMIT_PER_MINUTE=30

# ── secrets ────────────────────────────────────────────────────────────────
# A 32-byte urlsafe-base64 key. Generate with:
#   python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
#
# This is the key-encryption key: losing it means losing every stored
# credential in the deployment. Keep it in a secret manager, injected at
# runtime -- not in this file on a disk somebody backs up.
SECRET_ENCRYPTION_KEY=FILL_ME
# Must be false. When true a passphrase can stand in for a real key, and every
# stored credential is then protected by that passphrase's entropy.
ALLOW_DERIVED_ENCRYPTION_KEY=false

# ── engine boundary ────────────────────────────────────────────────────────
ENGINE_TYPE=N8N_CORE
# Cluster-internal only. This address must not be routable from the internet
# and must never appear in an API response (guardrail 15).
ENGINE_BASE_URL=http://engine.appbi-workflow.svc.cluster.local:8099
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
ENGINE_INTERNAL_TOKEN=FILL_ME
ENGINE_TIMEOUT_SECONDS=30
ENGINE_VALIDATE_TIMEOUT_SECONDS=30
ENGINE_DISPATCH_TIMEOUT_SECONDS=15
# Leave false. The product is designed to stay readable during an engine
# outage (SRS 9.6), and refusing to boot turns a degraded product into an
# outage of the whole control plane.
STARTUP_REQUIRE_ENGINE=false

# ── execution policy ───────────────────────────────────────────────────────
EXECUTION_MAX_RUNTIME_SECONDS=1200
EXECUTION_STALE_AFTER_SECONDS=120
# Per workflow. One is the V1 contract: two runs of one automation overlapping
# is almost never wanted, and the schedule trigger's overlap policy is how a
# tenant asks for different behaviour.
MAX_CONCURRENT_EXECUTIONS_PER_WORKFLOW=1
# The global ceiling. A per-tenant one is set at provisioning time
# (`python -m app.provision quota <id> --max-concurrent N`).
MAX_CONCURRENT_EXECUTIONS_PER_WORKSPACE=10
EXECUTION_PREVIEW_RETENTION_DAYS=14

# ── webhook gateway ────────────────────────────────────────────────────────
# The origin webhook URLs are built from, and handed to third parties. Must be
# https: a webhook URL carries a signing secret in its request, and http would
# publish the payload.
PUBLIC_BASE_URL=https://FILL_ME
WEBHOOK_MAX_BODY_BYTES=524288
# Counted in the database, so this is the real limit however many API replicas
# are running.
WEBHOOK_RATE_LIMIT_PER_MINUTE=120

# ── HTTP Request egress policy (SRS 32.2) ──────────────────────────────────
# Must stay false in production: true lets any workflow reach anything inside
# the cluster, including the engine's own internal port and the database.
EGRESS_ALLOW_PRIVATE_NETWORKS=false
# Optional and exclusive: set it and workflows can reach nothing else. Strongly
# recommended for a tenant-facing deployment.
EGRESS_ALLOWED_HOSTS=
EGRESS_BLOCKED_HOSTS=169.254.169.254,metadata.google.internal,metadata.azure.com
EGRESS_MAX_REDIRECTS=5
EGRESS_MAX_RESPONSE_BYTES=8388608
EGRESS_REQUEST_TIMEOUT_SECONDS=60

# ── engine service ─────────────────────────────────────────────────────────
ENGINE_PORT=8099
# Bind inside the pod only. The service, network policy and the absence of an
# ingress are the other three layers of the same rule.
ENGINE_HOST=0.0.0.0
ENGINE_LOG_LEVEL=warn
ENGINE_MAX_CONCURRENT=20
ENGINE_MAX_EXECUTION_SECONDS=1800

# ── images ─────────────────────────────────────────────────────────────────
# Pinned by digest, or at least by an immutable tag. `:latest` is rejected by
# the doctor: a rollback that cannot name what it is rolling back to is not a
# rollback.
IMAGE_REGISTRY=registry.example.com/appbi
IMAGE_TAG=FILL_ME

# ── bootstrap (first deploy only) ──────────────────────────────────────────
# Creates the platform admin. The account must change this password before it
# can do anything else, so this is a one-time secret rather than a credential.
# Remove both values once the first deploy has completed.
BOOTSTRAP_ADMIN_EMAIL=FILL_ME
BOOTSTRAP_ADMIN_PASSWORD=FILL_ME
BOOTSTRAP_TIMEZONE=Asia/Bangkok

# ── frontend ───────────────────────────────────────────────────────────────
# The browser-visible origin. Must be https and must be the same origin the
# ingress terminates TLS on.
NEXT_PUBLIC_API_BASE=https://FILL_ME
# Where the frontend's server-side proxy forwards. Cluster-internal.
API_PROXY_TARGET=http://api.appbi-workflow.svc.cluster.local:8000

# ── ops ────────────────────────────────────────────────────────────────────
# Recorded in the release artefact and shown in the runbook header. A release
# with nobody named to call is not a release.
ONCALL_CONTACT=FILL_ME
BACKUP_S3_BUCKET=FILL_ME
BACKUP_RETENTION_DAYS=30
